---
// Bordered card with an icon, a title and a one-liner. Children render as the
// card's visual, above the text.
import { Icon } from 'astro-icon/components';

interface Props {
	icon: string;
	title: string;
	body: string;
	class?: string;
}
const { icon, title, body, class: className = '' } = Astro.props;
---

<article
	class:list={[
		'group flex flex-col overflow-hidden rounded-2xl border border-line bg-white transition-colors hover:border-neutral-400',
		className,
	]}
>
	<slot />
	<div class="flex flex-1 flex-col p-6">
		<div class="flex items-center gap-3">
			<span class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-line bg-surface text-ink">
				<Icon name={icon} class="size-4" />
			</span>
			<h3 class="text-base font-semibold">{title}</h3>
		</div>
		<p class="mt-3 text-sm leading-relaxed text-muted">{body}</p>
	</div>
</article>
