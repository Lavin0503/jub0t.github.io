---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../assets/logo.png';
import Container from './Container.astro';
import { site, nav } from '../data/site';

interface Props {
	stars: string;
}
const { stars } = Astro.props;
---

<header class="sticky top-0 z-20 border-b border-line bg-white/90 backdrop-blur">
	<Container class="flex h-16 items-center justify-between gap-6">
		<a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
			<Image src={logo} alt="" width={28} height={28} class="rounded-md" />
			<span>{site.name}</span>
		</a>

		<nav class="hidden items-center gap-7 text-sm text-muted md:flex">
			{nav.map((item) => <a href={item.href} class="transition-colors hover:text-ink">{item.label}</a>)}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href={site.repoUrl}
				rel="noopener"
				class="inline-flex h-9 items-center gap-2 rounded-md border border-line px-3 text-sm font-medium transition-colors hover:border-ink"
			>
				<Icon name="simple-icons:github" class="size-4" />
				<span class="hidden sm:inline">GitHub</span>
				<span class="flex items-center gap-1 border-l border-line pl-2 font-mono text-xs text-muted">
					<Icon name="lucide:star" class="size-3" />
					{stars}
				</span>
			</a>
			<a
				href="#download"
				class="inline-flex h-9 items-center gap-2 rounded-md bg-ink px-3.5 text-sm font-medium text-white transition-colors hover:bg-neutral-800"
			>
				<Icon name="lucide:download" class="size-4" />
				Download
			</a>
		</div>
	</Container>
</header>
