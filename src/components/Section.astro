---
// A numbered section: hairline rule, small mono index and label, then content.
import Container from './Container.astro';

interface Props {
	id: string;
	index: string;
	label: string;
	class?: string;
}
const { id, index, label, class: className = '' } = Astro.props;
---

<section id={id} class:list={['scroll-mt-16 border-t border-line', className]}>
	<Container class="py-20 sm:py-24">
		<div class="mb-10 flex items-center gap-3 font-mono text-xs tracking-wide text-faint uppercase">
			<span>{index}</span>
			<span aria-hidden="true" class="h-px w-6 bg-line"></span>
			<span>{label}</span>
		</div>
		<slot />
	</Container>
</section>
